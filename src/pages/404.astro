---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not found · George Miles">
	<div class="max-w-2xl pt-20 pb-32 sm:pt-28">
		<p class="text-soft font-mono text-sm">
			<span class="text-accent">$</span> cd ./this-page
			<br />
			cd: no such file or directory
		</p>
		<h1 class="mt-6 text-5xl leading-none font-bold tracking-[-0.04em] sm:text-6xl">No such page</h1>
		<a
			href="/"
			class="border-line bg-surface text-ink hover:border-soft mt-9 inline-flex h-12 items-center gap-2 rounded-lg border px-5 text-[0.9375rem] font-medium transition-colors"
		>
			<svg
				class="size-4"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M19 12H5m6 6-6-6 6-6"></path>
			</svg>
			Back to gmiles.dev
		</a>
	</div>
</Layout>
