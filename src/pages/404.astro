---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not found · George Miles">
	<div class="mx-auto max-w-3xl pt-24">
		<p class="text-accent font-mono text-sm">
			~/gmiles.dev <span class="text-soft">$ cd: no such file or directory</span>
		</p>
		<h1 class="font-display mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">No such page</h1>
		<a href="/" class="text-accent mt-8 inline-block font-mono text-sm underline underline-offset-4">
			back to gmiles.dev
		</a>
	</div>
</Layout>
