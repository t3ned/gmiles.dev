---
import { contracting, profile } from "@/data";
import Section from "./Section.astro";
---

<Section id="hire" title="Work with me">
	<h3 class="text-2xl font-semibold tracking-[-0.025em] sm:text-[1.625rem]">{contracting.title}</h3>
	<p class="text-soft mt-3 max-w-[60ch] text-[1.0625rem] leading-relaxed sm:text-lg">{contracting.pitch}</p>

	<dl class="border-line mt-8 border-t">
		{contracting.terms.map((item) => (
			<div class="border-line grid gap-x-8 gap-y-0.5 border-b py-3 sm:grid-cols-[12rem_minmax(0,1fr)]">
				<dt class="text-ink font-medium">{item.term}</dt>
				<dd class="text-soft">{item.detail}</dd>
			</div>
		))}
	</dl>

	<div class="border-line bg-surface mt-10 flex flex-col gap-6 rounded-2xl border p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
		<div>
			<p class="text-xl font-semibold tracking-[-0.02em] sm:text-2xl">{contracting.cta.title}</p>
			<p class="text-soft mt-1">{contracting.cta.detail}</p>
		</div>
		<div class="flex shrink-0 flex-col items-start gap-2.5 sm:items-end">
			<a
				href={contracting.bookingUrl}
				target="_blank"
				rel="noopener"
				class="bg-accent-fill text-on-accent group inline-flex h-12 items-center gap-2.5 rounded-lg pr-4 pl-5 text-[0.9375rem] font-semibold shadow-[0_1px_2px_rgb(0_0_0/0.2)] hover:bg-accent-fill-hover transition-colors"
			>
				Book a free call
				<svg
					class="size-4 transition-transform group-hover:translate-x-0.5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.25"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14m-6-6 6 6-6 6"></path>
				</svg>
			</a>
			<p class="text-soft text-sm">
				or email{" "}
				<a href={`mailto:${profile.email}`} class="link">
					{profile.email}
				</a>
			</p>
		</div>
	</div>
</Section>
