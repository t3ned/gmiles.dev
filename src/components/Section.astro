---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<!-- Rail layout. The heading sits in a sticky left column on wide screens and stacks above on narrow ones -->
<section id={id} class="border-line scroll-mt-16 border-t py-16 sm:py-24" aria-labelledby={`${id}-title`}>
	<div class="grid gap-8 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
		<h2
			id={`${id}-title`}
			class="text-2xl font-semibold tracking-[-0.025em] text-balance sm:text-[1.75rem] lg:sticky lg:top-28 lg:self-start"
		>
			{title}
		</h2>
		<div class="min-w-0">
			<slot />
		</div>
	</div>
</section>
