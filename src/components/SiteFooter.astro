---
import { profile } from "@/data";
---

<footer id="contact" class="border-line mt-32 scroll-mt-16 border-t">
	<div class="mx-auto max-w-5xl px-6 py-14 sm:py-16">
		<a
			href={`mailto:${profile.email}`}
			class="reveal font-display hover:text-accent inline-block text-4xl font-extrabold tracking-tight break-all transition-colors sm:text-6xl"
		>
			{profile.email}
			<svg
				class="text-accent inline size-[0.7em] align-baseline"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14m-7-7 7 7-7 7"></path>
			</svg>
		</a>
		<div
			class="reveal text-soft mt-10 flex flex-col gap-3 font-mono text-xs sm:flex-row sm:items-center sm:justify-between"
			style="transition-delay: 80ms"
		>
			<p>© {new Date().getFullYear()} George Miles</p>
			<nav class="flex items-center gap-4">
				<a href="/privacy" class="hover:text-accent transition-colors">
					privacy
				</a>
				<a href="/terms" class="hover:text-accent transition-colors">
					terms
				</a>
				<a href="/refunds" class="hover:text-accent transition-colors">
					refunds
				</a>
			</nav>
			<a href={profile.linkedin} target="_blank" rel="noopener" class="hover:text-accent transition-colors">
				linkedin.com/in/gtmmiles
			</a>
		</div>
	</div>
</footer>
