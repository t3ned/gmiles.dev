---
import { profile } from "@/data";

const legal = [
	{ href: "/privacy", label: "Privacy" },
	{ href: "/terms", label: "Terms" },
	{ href: "/refunds", label: "Refunds" },
];
---

<footer id="contact" class="border-line mt-8 scroll-mt-16 border-t">
	<div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-14">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="font-mono text-sm font-medium">
					<span class="text-accent">~/</span>gmiles.dev
				</p>
				<a
					href={`mailto:${profile.email}`}
					class="hover:text-accent mt-3 inline-block text-3xl font-semibold tracking-[-0.03em] transition-colors sm:text-4xl"
				>
					{profile.email}
				</a>
			</div>
			<a
				href={profile.linkedin}
				target="_blank"
				rel="noopener"
				class="text-soft hover:text-ink flex w-fit items-center gap-2 text-sm transition-colors"
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"></path>
				</svg>
				linkedin.com/in/gtmmiles
			</a>
		</div>

		<div class="border-line text-soft mt-10 flex flex-col gap-3 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between">
			<p>
				© <span data-year>{new Date().getFullYear()}</span> {profile.name}
			</p>
			<nav class="flex items-center gap-6" aria-label="Legal">
				{legal.map((link) => (
					<a href={link.href} class="hover:text-ink transition-colors">
						{link.label}
					</a>
				))}
			</nav>
		</div>
	</div>
</footer>

<script is:inline>
	// The page is built once, so the year is refreshed in the browser
	document.querySelectorAll("[data-year]").forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
