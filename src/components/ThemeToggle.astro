<button
	id="theme-toggle"
	type="button"
	title="Toggle theme"
	aria-label="Toggle theme"
	class="text-soft hover:text-ink hover:bg-surface hover:border-line flex size-9 items-center justify-center rounded-lg border border-transparent transition-colors"
>
	<!-- sun (shown in dark mode: click for light) -->
	<svg
		class="hidden size-4 dark:block"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
	</svg>
	<!-- moon (shown in light mode: click for dark) -->
	<svg
		class="size-4 dark:hidden"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const button = document.getElementById("theme-toggle");
	const media = window.matchMedia("(prefers-color-scheme: dark)");

	/**
	 * Applies the dark state and keeps the button label pointing at the opposite theme
	 */
	const apply = (dark: boolean) => {
		root.classList.toggle("dark", dark);
		const label = dark ? "Switch to light theme" : "Switch to dark theme";
		button?.setAttribute("title", label);
		button?.setAttribute("aria-label", label);
	};

	apply(root.classList.contains("dark"));

	// Flip to the opposite of whatever is showing and remember the explicit choice
	button?.addEventListener("click", () => {
		const dark = !root.classList.contains("dark");
		localStorage.setItem("theme", dark ? "dark" : "light");
		apply(dark);
	});

	// Follow the OS while no explicit choice has been made
	media.addEventListener("change", (event) => {
		const pref = localStorage.getItem("theme");
		if (pref === null || pref === "system") apply(event.matches);
	});
</script>
