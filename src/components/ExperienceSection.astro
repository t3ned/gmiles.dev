---
import { type Role, roles } from "@/data";
import Section from "./Section.astro";

/**
 * Groups consecutive roles at the same company so promotions read as one tenure
 */
const groupByCompany = (list: Role[]) =>
	list.reduce<{ company: string; location: string; roles: Role[] }[]>((groups, role) => {
		const last = groups.at(-1);
		if (last?.company === role.company) last.roles.push(role);
		else groups.push({ company: role.company, location: role.location, roles: [role] });
		return groups;
	}, []);

/**
 * Splits a highlight into plain text and figures so the numbers can be set in heavier ink
 */
const splitFigures = (text: string) =>
	text
		.split(/((?<![\d.])~?\$?\d+(?:B\+|M|x|%|\+)?(?: to \d+| minutes)?(?![.\d]))/)
		.map((part, i) => ({ part, figure: i % 2 === 1 }));

const groups = groupByCompany(roles);
---

<Section id="experience" title="Experience">
	<ol class="divide-line -mt-2 divide-y">
		{groups.map((group) => (
			<li class="py-8 first:pt-0 last:pb-0">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
					<h3 class="text-xl font-semibold tracking-[-0.02em]">{group.company}</h3>
					<p class="text-soft text-sm">{group.location}</p>
				</div>

				<ol class="border-line mt-5 ml-1 space-y-8 border-l pl-6">
					{group.roles.map((role) => (
						<li class="relative">
							<span
								class="bg-bg border-soft absolute top-[0.45rem] -left-[1.8rem] size-[9px] rounded-full border-2"
								aria-hidden="true"
							/>
							<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
								<h4 class="text-accent font-medium">{role.title}</h4>
								<p class="text-soft font-mono text-[0.8125rem] tabular-nums">{role.period}</p>
							</div>
							<p class="text-soft mt-2.5 max-w-[68ch] leading-relaxed">{role.summary}</p>
							<ul class="mt-4 space-y-2">
								{role.highlights.map((highlight) => (
									<li class="text-soft flex max-w-[68ch] gap-3 text-[0.9375rem] leading-6">
										<span class="bg-accent mt-[11px] h-0.5 w-3 shrink-0" aria-hidden="true" />
										<span>
											{splitFigures(highlight).map(({ part, figure }) =>
												figure ? (
													<strong class="text-ink font-semibold tabular-nums">{part}</strong>
												) : (
													part
												),
											)}
										</span>
									</li>
								))}
							</ul>
						</li>
					))}
				</ol>
			</li>
		))}
	</ol>
</Section>
