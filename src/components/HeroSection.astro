---
import { Image } from "astro:assets";
import headshot from "@/assets/headshot.jpg";
import { contracting, profile } from "@/data";

const [title, org] = profile.role.split(", ");
---

<section class="grid items-center gap-8 pt-10 pb-20 sm:pt-20 sm:pb-28 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-20">
	<div class="order-2 lg:order-1">
		<h1 class="settle text-[3.25rem] leading-[0.95] font-bold tracking-[-0.04em] sm:text-7xl" style="--i: 0">
			{profile.name}
		</h1>
		<p
			class="settle text-soft mt-4 text-xl leading-snug font-medium tracking-[-0.015em] sm:text-[1.625rem]"
			style="--i: 1"
		>
			{title}
			{org && (
				<>
					{" "}
					at{" "}
					<a
						href={profile.companyUrl}
						target="_blank"
						rel="noopener"
						class="text-ink hover:text-accent group inline-flex items-center gap-1 transition-colors"
					>
						{org}
						<svg
							class="size-4 opacity-50 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 sm:size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 17 17 7M8 7h9v9"></path>
						</svg>
					</a>
				</>
			)}
		</p>
		<p class="settle text-soft mt-6 max-w-[60ch] text-[1.0625rem] leading-relaxed sm:text-lg" style="--i: 2">
			{profile.summary}
		</p>

		<div class="settle mt-9 flex flex-wrap items-center gap-3" style="--i: 3">
			<a
				href={contracting.bookingUrl}
				target="_blank"
				rel="noopener"
				class="bg-accent-fill text-on-accent group inline-flex h-12 w-full items-center justify-center gap-2.5 sm:w-auto rounded-lg pr-4 pl-5 text-[0.9375rem] font-semibold shadow-[0_1px_2px_rgb(0_0_0/0.2)] hover:bg-accent-fill-hover transition-colors"
			>
				Book a free call
				<svg
					class="size-4 transition-transform group-hover:translate-x-0.5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.25"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14m-6-6 6 6-6 6"></path>
				</svg>
			</a>
			<a
				href={profile.resumeUrl}
				class="border-line bg-surface text-ink hover:border-soft inline-flex h-12 flex-1 items-center justify-center rounded-lg sm:flex-none border px-5 text-[0.9375rem] font-medium transition-colors"
			>
				Request resume
			</a>
			<a
				href={profile.linkedin}
				target="_blank"
				rel="noopener"
				class="border-line bg-surface text-soft hover:text-ink hover:border-soft inline-flex size-12 items-center justify-center rounded-lg border transition-colors"
				aria-label="LinkedIn profile"
				title="LinkedIn"
			>
				<svg class="size-[1.125rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"></path>
				</svg>
			</a>
		</div>

		<ul class="settle text-soft mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm" style="--i: 4">
			<li class="flex items-center gap-2">
				<svg
					class="size-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
					<circle cx="12" cy="10" r="3" />
				</svg>
				{profile.location}
			</li>
			<li class="flex items-center gap-2" data-local-time hidden>
				<svg
					class="size-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="10" />
					<path d="M12 6v6l4 2" />
				</svg>
				<span>
					<time class="text-ink font-mono tabular-nums"></time> local time
				</span>
			</li>
			<li class="flex items-center gap-2">
				<svg
					class="size-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="10" />
					<path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />
				</svg>
				{profile.remote}
			</li>
		</ul>
	</div>

	<!-- Hovering flips the portrait over to a joke on the back -->
	<figure class="settle order-1 w-32 sm:w-40 lg:order-2 lg:w-full" style="--i: 1">
		<div class="group perspective-distant">
			<div class="portrait relative transform-3d group-hover:rotate-y-180">
				<Image
					src={headshot}
					alt="Portrait of George Miles"
					width={640}
					height={640}
					loading="eager"
					fetchpriority="high"
					class="aspect-square w-full rounded-xl object-cover shadow-[0_1px_2px_rgb(0_0_0/0.08),0_24px_48px_-24px_rgb(0_0_0/0.35)] backface-hidden sm:rounded-2xl lg:aspect-[4/5]"
				/>
				<div
					class="border-line bg-surface absolute inset-0 flex rotate-y-180 flex-col justify-end gap-2 rounded-xl border p-3 backface-hidden sm:rounded-2xl sm:p-5 lg:p-7"
					aria-hidden="true"
				>
					<p class="text-sm leading-tight font-semibold tracking-[-0.02em] text-balance sm:text-lg lg:text-[1.75rem]">
						{profile.photoQuip}
					</p>
					<p class="text-accent font-mono text-xs lg:text-sm">$ cd ..</p>
				</div>
			</div>
		</div>
	</figure>
</section>

<script is:inline define:vars={{ timeZone: profile.timeZone }}>
	// Shows George's local time so visitors in other zones know when to expect a reply
	const item = document.querySelector("[data-local-time]");
	const time = item?.querySelector("time");
	const format = new Intl.DateTimeFormat("en-GB", { timeZone, hour: "2-digit", minute: "2-digit" });

	/**
	 * Writes the current time in the configured zone
	 */
	const tick = () => {
		if (!item || !time) return;
		time.textContent = format.format(new Date());
		item.hidden = false;
	};

	tick();
	setInterval(tick, 30_000);
</script>
