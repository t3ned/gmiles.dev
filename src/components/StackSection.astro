---
import { stack } from "@/data";
import Section from "./Section.astro";
---

<Section id="stack" title="Stack">
	<!-- Terminal window: dark in both themes -->
	<div class="bg-term overflow-hidden rounded-xl shadow-[0_1px_2px_rgb(0_0_0/0.1),0_20px_40px_-24px_rgb(0_0_0/0.45)] ring-1 ring-black/5 dark:ring-white/10">
		<div class="flex items-center gap-2 border-b border-white/[0.07] px-4 py-3">
			<span class="size-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
			<span class="size-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
			<span class="size-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
			<span class="ml-auto font-mono text-xs text-white/45">george@gmiles: ~/stack</span>
		</div>

		<div class="overflow-x-auto p-5 font-mono text-[0.8125rem] leading-relaxed sm:p-7 sm:text-sm">
			<p class="text-white/60">
				<span class="text-[#ff8c42]">$</span> tree ./career <span class="text-white/45">--sort started</span>
			</p>

			<div class="mt-5 space-y-4">
				{stack.map((layer, i) => (
					<div>
						<p class="-indent-[4ch] pl-[4ch]">
							<span class="text-white/30 select-none">{i === stack.length - 1 ? "└── " : "├── "}</span>
							<span class="font-medium text-[#ff8c42]">{layer.name}</span>
							<span class="text-white/45"> # {layer.note}</span>
						</p>
						<p class="mt-1 pl-[4ch] text-white/80">
							{layer.items.map((item, j) => (
								<>
									{j > 0 && <span class="text-white/30 select-none"> · </span>}
									<span class="whitespace-nowrap">{item}</span>
								</>
							))}
						</p>
					</div>
				))}
			</div>

			<p class="mt-5 text-white/60">
				<span class="text-[#ff8c42]">$</span>
				<span
					class="ml-1 inline-block h-[1.05em] w-[0.55em] translate-y-[0.18em] bg-white/60"
					aria-hidden="true"
				></span>
			</p>
		</div>
	</div>
</Section>
