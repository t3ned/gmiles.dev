---
import SiteFooter from "@/components/SiteFooter.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { profile } from "@/data";
import "@/style.css";

interface Props {
	title: string;
	/** Shows the section nav. Only the home page has sections to jump to */
	nav?: boolean;
}

const { title, nav = false } = Astro.props;

const links = [
	{ href: "#experience", label: "Experience" },
	{ href: "#stack", label: "Stack" },
	{ href: "#education", label: "Education" },
	{ href: "#hire", label: "Hire" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="George Miles, senior backend engineer working the full stack. Rust, distributed systems, DevOps, and modern frontend."
		/>
		<meta name="theme-color" content="#f6f6f4" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Schibsted+Grotesk:ital,wght@0,400..800;1,400&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>

		<script is:inline>
			// Apply theme before first paint to avoid a flash of the wrong theme
			(() => {
				const pref = localStorage.getItem("theme");
				const dark =
					pref === "dark" ||
					((pref === null || pref === "system") && window.matchMedia("(prefers-color-scheme: dark)").matches);
				document.documentElement.classList.toggle("dark", dark);
			})();
		</script>
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main"
			class="bg-accent-fill text-on-accent sr-only rounded-md px-3 py-2 text-sm font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
		>
			Skip to content
		</a>

		<header class="border-line bg-bg sticky top-0 z-20 border-b">
			<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
				<a href="/" class="group flex items-baseline gap-2.5 font-mono text-sm" aria-label="gmiles.dev home">
					<span class="font-medium">
						<span class="text-accent">~/</span>gmiles.dev
					</span>
					<span class="text-soft" aria-hidden="true">
						$ whoami
						<span class="bg-accent ml-1 inline-block h-[1.05em] w-[0.5em] translate-y-[0.18em]"></span>
					</span>
				</a>

				<div class="flex items-center gap-1 sm:gap-2">
					{nav && (
						<nav class="mr-3 hidden items-center gap-7 text-sm md:flex" aria-label="Sections">
							{links.map((link) => (
								<a href={link.href} class="text-soft hover:text-ink transition-colors">
									{link.label}
								</a>
							))}
						</nav>
					)}
					<a
						href={profile.resumeUrl}
						class="text-ink hover:bg-surface hover:border-line flex h-9 items-center gap-2 rounded-lg border border-transparent px-3 text-sm font-medium transition-colors"
					>
						<span class="hidden sm:inline">Request resume</span>
						<span class="sm:hidden">Resume</span>
					</a>
					<ThemeToggle />
				</div>
			</div>
		</header>

		<main id="main" class="mx-auto w-full max-w-6xl flex-1 px-5 sm:px-8">
			<slot />
		</main>

		<SiteFooter />
	</body>
</html>
